---
import { SITE_TIMEZONE } from '../consts';

interface Props {
	date: Date;
	/** 显示日期所用的时区（IANA 名称）；不传则使用 consts.SITE_TIMEZONE。 */
	timeZone?: string;
}

const { date, timeZone = SITE_TIMEZONE } = Astro.props;
---

<time datetime={date.toISOString()}>
		{
			date.toLocaleDateString('zh-CN', {
				year: 'numeric',
				month: 'long',
				day: 'numeric',
				timeZone,
			})
		}
</time>
