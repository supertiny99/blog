---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { title, pubDate, timezone, heroImage, tags } = post.data;
---

<li class="post-card">
	<a href={`/blog/${post.id}/`} class="card">
		{heroImage && <Image width={720} height={360} src={heroImage} alt="" />}
		<h4 class="title">{title}</h4>
		<p class="date">
			<FormattedDate date={pubDate} timeZone={timezone} />
		</p>
	</a>
	{
		tags.length > 0 && (
			<ul class="tags">
				{tags.map((tag) => (
					<li>
						<a href={`/blog/tags/${tag}/`}>#{tag}</a>
					</li>
				))}
			</ul>
		)
	}
</li>

<style>
	/* 卡片本体（样式自治，从列表页迁入；选择器挂 .post-card 避开标签条里嵌套 li） */
	.post-card {
		width: calc(50% - 1rem);
	}
	.post-card * {
		text-decoration: none;
		transition: 0.2s ease;
	}
	.post-card:first-child {
		width: 100%;
		margin-bottom: 1rem;
		text-align: center;
	}
	.post-card:first-child img {
		width: 100%;
	}
	.post-card:first-child .title {
		font-size: 2.369rem;
	}
	.post-card img {
		margin-bottom: 0.5rem;
		border-radius: 12px;
	}
	.post-card .card {
		display: block;
	}
	.title {
		margin: 0;
		color: rgb(var(--black));
		line-height: 1;
	}
	.date {
		margin: 0;
		color: rgb(var(--gray));
	}
	.post-card .card:hover h4,
	.post-card .card:hover .date {
		color: rgb(var(--accent));
	}
	.post-card .card:hover img {
		box-shadow: var(--box-shadow);
	}

	/* 标签条 */
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	.tags li {
		width: auto;
		margin: 0;
	}
	.tags a {
		display: inline-block;
		padding: 0.1em 0.6em;
		font-size: 0.85rem;
		color: rgb(var(--gray));
		border: 1px solid rgb(var(--gray));
		border-radius: 999px;
	}
	.tags a:hover {
		color: rgb(var(--accent));
		border-color: rgb(var(--accent));
	}

	@media (max-width: 720px) {
		.post-card {
			width: 100%;
			text-align: center;
		}
		.post-card:first-child {
			margin-bottom: 0;
		}
		.post-card:first-child .title {
			font-size: 1.563em;
		}
	}
</style>
